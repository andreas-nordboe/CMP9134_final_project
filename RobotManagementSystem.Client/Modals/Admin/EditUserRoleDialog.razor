@using RobotManagementSystem.Shared.Models.Users
<MudDialog>
    <DialogContent>
        <MudText Class="my-2">Choose a new role for <b>@UserAccount.Username</b></MudText>
        <MudText Class="my-2 mb-4">Current role: <b>@UserAccount.Role</b></MudText>
        
        <MudSelect T="UserRole"
                   @bind-Value="_selectedRole"
                   Label="Select Role"
                   Class="my-4">

            @foreach (var role in Enum.GetValues<UserRole>())
            {
                <MudSelectItem Value="@role">
                    @role
                </MudSelectItem>
            }
        </MudSelect>
        
    </DialogContent>
    <DialogActions>
        <MudButton Color="@Color.Primary" Variant="Variant.Filled" OnClick="ChangeUserRole">Update Role</MudButton>
        <MudButton OnClick="Cancel">Cancel</MudButton>
    </DialogActions>
</MudDialog>