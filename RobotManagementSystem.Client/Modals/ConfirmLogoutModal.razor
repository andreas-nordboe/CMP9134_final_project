@using MudBlazor
@inject IJSRuntime JSRuntime

<MudDialog>
    <DialogContent>
        <MudText Typo="Typo.body1">
            Log Out
        </MudText>

        <MudText Typo="Typo.body2" Class="mt-2">
            Are you sure you want to log out?
        </MudText>
    </DialogContent>

    <DialogActions>
        <MudButton id="reset-cancel-button"
                   Color="Color.Default"
                   Variant="Variant.Text"
                   OnClick="Cancel">
            Cancel
        </MudButton>

        <MudButton id="reset-confirm-button"
                   Color="Color.Error"
                   Variant="Variant.Filled"
                   OnClick="Confirm">
            Reset
        </MudButton>
    </DialogActions>
</MudDialog>