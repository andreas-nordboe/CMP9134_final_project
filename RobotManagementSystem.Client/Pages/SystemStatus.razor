@page "/system-status"
@using System.Globalization
@using RobotManagementSystem.Shared.Models.SystemStatus

<MudGrid Spacing="2">

    <MudItem xs="12" md="5">
        <MudPaper Class="pa-3 mb-3" Outlined="true">
            <MudText Typo="Typo.h6">API Connection Status</MudText>

            <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="1">
                <MudIcon Icon="@Icons.Material.Filled.Circle" Color="Color.Success" Size="Size.Small" />
                <MudText>Online</MudText>
            </MudStack>

            <MudDivider Class="my-2" />

            <MudGrid>
                <MudItem xs="6">
                    <MudText Typo="Typo.subtitle2">Average Latency</MudText>
                    <MudText Typo="Typo.h6">32ms</MudText>
                </MudItem>

                <MudItem xs="6">
                    <MudText Typo="Typo.subtitle2">Retry Attempts</MudText>
                    <MudText Typo="Typo.h6">4</MudText>
                </MudItem>

                <MudItem xs="6">
                    <MudText Typo="Typo.subtitle2">Signal State</MudText>
                    <MudText>Stable</MudText>
                </MudItem>

                <MudItem xs="6">
                    <MudText Typo="Typo.subtitle2">Last Updated</MudText>
                    <MudText>16.03.2026 11:44:21</MudText>
                </MudItem>
            </MudGrid>
        </MudPaper>

        <MudPaper Class="pa-3" Outlined="true">
            <MudText Typo="Typo.h6">API Response Time</MudText>

            @* Later: chart goes here *@
            <MudText Class="pa-6" Align="Align.Center">
                Chart placeholder
            </MudText>
        </MudPaper>
    </MudItem>

    <MudItem xs="12" md="7">
        <MudPaper Class="pa-3" Outlined="true">
            <MudText Typo="Typo.h6" Class="mb-2">Event Status</MudText>

            <MudTable T="SystemStatusLog"
                      @ref="_table"
                      ServerData="LoadServerData"
                      Dense="true"
                      Hover="true"
                      RowsPerPage="10">

                <HeaderContent>
                    <MudTh>Event Timestamp</MudTh>
                    <MudTh>Event Status</MudTh>
                </HeaderContent>

                <RowTemplate>
                    <MudTd>
                        @context.Timestamp.ToString("ddd dd.MM.yyyy - HH:mm:ss")
                    </MudTd>
                    <MudTd>
                        @context.Message
                    </MudTd>
                </RowTemplate>

                <PagerContent>
                    <MudTablePager PageSizeOptions="new int[] { 10, 25, 50 }" />
                </PagerContent>

            </MudTable>
        </MudPaper>
    </MudItem>

</MudGrid>