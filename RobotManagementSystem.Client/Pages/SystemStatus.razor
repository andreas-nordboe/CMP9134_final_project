@page "/system-status"
@using System.Globalization
@using RobotManagementSystem.Client.Components
@using RobotManagementSystem.Shared.Models.SystemStatus
@using Microsoft.AspNetCore.Authorization
@attribute [Authorize]

<MudContainer MaxWidth="MaxWidth.False" Class="px-6 py-4">
    <MudGrid Spacing="2">

    <MudItem xs="12" md="4">
        <SystemStatusSummaryComponent />
    </MudItem>

    <MudItem xs="12" md="8">
        <MudPaper Class="pa-3 d-flex flex-column" Style="height: 780px;" Outlined="true">
            <MudStack Row="true" Spacing="2" Class="mb-4">
                
                <MudTooltip Text="Refresh event log">
                    <MudIconButton Icon="@Icons.Material.Filled.Refresh"    
                                   Color="Color.Primary"
                                   Size="Size.Medium"
                                   OnClick="RefreshLogsAsync" />
                </MudTooltip>
                
                <MudSelect T="SystemStatusEventType?"
                           Label="Event Type"
                           Value="@SelectedEventType"
                           ValueChanged="OnEventTypeChanged"
                           Clearable="true"
                           Dense="true"
                           Style="min-width: 220px;">

                    @foreach (SystemStatusEventType eventType in Enum.GetValues<SystemStatusEventType>())
                    {
                        <MudSelectItem T="SystemStatusEventType?"
                                       Value="@((SystemStatusEventType?)eventType)">
                            @FormatEventType(eventType)
                        </MudSelectItem>
                    }
                </MudSelect>

                <MudDatePicker Label="From Date"
                               Date="@FromDate"
                               DateChanged="OnFromDateChanged"
                               Clearable="true"
                               Dense="true" />
            </MudStack>

            <MudTable T="SystemStatusLog"
                      Class="flex-grow-1"
                      @ref="_table"
                      ServerData="LoadServerData"
                      Dense="true"
                      Hover="true"
                      Loading="@IsLoadingSystemLogs"
                      FixedHeader="true"
                      Height="620px"
                      LoadingProgressColor="Color.Info"
                      RowsPerPage="25">

                <HeaderContent>
                    <MudTh>Timestamp</MudTh>
                    <MudTh>Event Type</MudTh>
                    <MudTh>Message</MudTh>
                    <MudTh>Current Status</MudTh>
                    <MudTh>Position</MudTh>
                    <MudTh>Battery</MudTh>
                    <MudTh>Robot State</MudTh>
                </HeaderContent>

                <RowTemplate>
                    <MudTd DataLabel="Timestamp">
                        @context.Timestamp.ToString("ddd dd.MM.yyyy - HH:mm:ss", CultureInfo.GetCultureInfo("en-GB"))
                    </MudTd>

                    <MudTd DataLabel="Event Type">
                        @FormatEventType(context.EventType)
                    </MudTd>

                    <MudTd DataLabel="Message">
                        @context.Message
                    </MudTd>

                    <MudTd DataLabel="Current Status">
                        @(string.IsNullOrWhiteSpace(context.CurrentStatus) ? "N/A" : context.CurrentStatus)
                    </MudTd>

                    <MudTd DataLabel="Position">
                        @if (context.RobotX.HasValue && context.RobotY.HasValue)
                        {
                            <span>(@context.RobotX, @context.RobotY)</span>
                        }
                        else
                        {
                            <span>N/A</span>
                        }
                    </MudTd>

                    <MudTd DataLabel="Battery">
                        @if (context.Battery.HasValue)
                        {
                            <span>@($"{context.Battery.Value:0.##}%")</span>
                        }
                        else
                        {
                            <span>N/A</span>
                        }
                    </MudTd>

                    <MudTd DataLabel="Robot State">
                        @(string.IsNullOrWhiteSpace(context.RobotState) ? "N/A" : context.RobotState)
                    </MudTd>
                </RowTemplate>

                <NoRecordsContent>
                    <MudText>No system status logs found.</MudText>
                </NoRecordsContent>

                <PagerContent>
                    <MudTablePager PageSizeOptions="new int[] { 10, 25, 50 }"/>
                </PagerContent>

            </MudTable>
        </MudPaper>
    </MudItem>

</MudGrid>
</MudContainer>