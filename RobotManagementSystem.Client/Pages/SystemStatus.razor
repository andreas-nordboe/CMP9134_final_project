@page "/system-status"
@using System.Globalization
@using RobotManagementSystem.Client.Components
@using RobotManagementSystem.Shared.Models.SystemStatus

<MudContainer MaxWidth="MaxWidth.False" Class="px-6 py-4">
    <MudGrid Spacing="2">

    <MudItem xs="12" md="5">
        <SystemStatusSummaryComponent />
    </MudItem>

    <MudItem xs="12" md="7">
        <MudPaper Class="pa-3" Outlined="true">
            <MudText Typo="Typo.h6" Class="mb-2">Event Status</MudText>

            <MudTable T="SystemStatusLog"
                      Class="flex-grow-1"
                      @ref="_table"
                      ServerData="LoadServerData"
                      Dense="true"
                      Hover="true"
                      Loading="@IsLoadingSystemLogs"
                      LoadingProgressColor="Color.Info"
                      RowsPerPage="10">

                <HeaderContent>
                    <MudTh>Event Timestamp</MudTh>
                    <MudTh>Event Type</MudTh>
                    <MudTh>Event Status</MudTh>
                </HeaderContent>

                <RowTemplate>
                    <MudTd>
                        @context.Timestamp.ToString("ddd dd.MM.yyyy - HH:mm:ss", CultureInfo.GetCultureInfo("en-GB"))
                    </MudTd>
                    <MudTd>
                        @FormatEventType(context.EventType)
                    </MudTd>
                    <MudTd>
                        @context.Message
                    </MudTd>
                </RowTemplate>
                
                <NoRecordsContent>
                    <MudText>No system status logs found.</MudText>
                </NoRecordsContent>

                <PagerContent>
                    <MudTablePager PageSizeOptions="new int[] { 10, 25, 50 }" />
                </PagerContent>

            </MudTable>
        </MudPaper>
    </MudItem>

</MudGrid>
</MudContainer>