@page "/login"
@using MudBlazor;
@using RobotManagementSystem.Client.Services
@inject IAppState appState

<MudContainer MaxWidth="MaxWidth.Small" Class="d-flex align-center justify-center" Style="height: 100vh">
    <MudPaper Height="450px" Width="100%" Elevation="12" Class="px-4 py-4">
        <MudForm>
            <MudText Align="Align.Center" Typo="Typo.h5" Class="mb-4">
                <b>Sign In</b>
            </MudText>
            <MudTextField @bind-Value="@LoginDetails.Username" Class="my-3" T="string" Variant="Variant.Outlined" Label="Enter Username" Required="true"></MudTextField>
            <MudTextField @bind-Value="@LoginDetails.Password" Class="my-3" T="string" Variant="Variant.Outlined" Label="Enter Password" Required="true" InputType="InputType.Password"></MudTextField>
            <MudCheckBox @bind-Value="@StayLoggedIn" Label="Stay Signed In" Color="Color.Primary"></MudCheckBox>
            <MudButton OnClick="LoginUser" Variant="Variant.Filled" Color="Color.Primary" FullWidth="true" Class="mt-6">Sign In</MudButton>
            <MudButton Href="/register" Variant="Variant.Filled" Color="Color.Primary" FullWidth="true" Class="mt-6">Register</MudButton>
        </MudForm>
    </MudPaper>
</MudContainer>