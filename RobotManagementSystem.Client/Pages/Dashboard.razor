@page "/"
@using RobotManagementSystem.Client.Components
@using RobotManagementSystem.Client.Services
@inject IAppState AppState

<MudContainer MaxWidth="MaxWidth.False" Class="px-6 py-4 dashboard-page">

    @if (AppState.IsUserLoggedIn())
    {
        <MudText Typo="Typo.h4" Class="mb-4 fw-bold">
            Ground Control Station
        </MudText>
    }

    <MudGrid Spacing="2" Class="dashboard-grid">

        <MudItem xs="12" lg="7" xl="8" Class="dashboard-left">
            <MudPaper Class="dashboard-card map-card" Outlined="true">
                <div class="summary-header">
                </div>
                <div class="map-card-body">
                    <GridComponent />
                </div>
            </MudPaper>
        </MudItem>

        <MudItem xs="12" lg="5" xl="4" Class="dashboard-right">
            <MudStack Spacing="2" Class="h-100">

                <MudPaper Class="dashboard-card" Outlined="true">
                    <RobotTelemetryComponent />
                </MudPaper>

                <MudPaper Class="dashboard-card flex-grow-1" Outlined="true">
                    <CommanderControls />
                </MudPaper>

            </MudStack>
        </MudItem>

    </MudGrid>

</MudContainer>