@page "/register"
@using MudBlazor;
@using RobotManagementSystem.Client.Services
@inject IAppState AppState
@inject ISnackbar SnackBar

<MudContainer MaxWidth="MaxWidth.Small" Class="d-flex align-center justify-center" Style="height: 100vh">
    <MudPaper Height="700px" Width="100%" Elevation="12" Class="px-4 py-4">
        <MudForm>
            <MudText Align="Align.Center" Typo="Typo.h5" Class="mb-4">
                <b>Register</b>
            </MudText>
            <MudTextField @bind-Value="@UserDetails.FirstName" Class="my-3" T="string" Variant="Variant.Outlined" Label="Enter First Name" Required="true"></MudTextField>
            <MudTextField @bind-Value="@UserDetails.LastName" Class="my-3" T="string" Variant="Variant.Outlined" Label="Enter Last Name"></MudTextField>
            <MudTextField @bind-Value="@UserDetails.Username" Class="my-3" T="string" Variant="Variant.Outlined" Label="Enter Username"></MudTextField>
            <MudTextField @bind-Value="@UserDetails.Password" Class="my-3" T="string" Variant="Variant.Outlined" Label="Enter Password" Required="true" InputType="InputType.Password"></MudTextField>
            <MudTextField @bind-Value="@UserDetails.RepeatPassword" Class="my-3" T="string" Variant="Variant.Outlined" Label="Repeat Password" Required="true" InputType="InputType.Password"></MudTextField>
            <MudButton OnClick="RegisterUser" Variant="Variant.Filled" Color="Color.Primary" FullWidth="true" Class="mt-6">Register User</MudButton>
            <MudButton Href="/login" Variant="Variant.Filled" Color="Color.Primary" FullWidth="true" Class="mt-6">Back</MudButton>
        </MudForm>
    </MudPaper>
</MudContainer>