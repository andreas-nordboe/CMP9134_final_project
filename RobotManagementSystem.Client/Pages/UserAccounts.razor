@page "/user-account"
@using RobotManagementSystem.Client.Services
@using RobotManagementSystem.Client.Services.DataStore
@using RobotManagementSystem.Client.Services.Sessions
@using RobotManagementSystem.Shared.Models.Users
@inject IAppState appState
@inject IDataStoreService _dataStore
@implements IDisposable


<MudPaper Class="user-accounts-card pa-0" Outlined="true">

    <div class="summary-header">
        <span>Your User Account</span>
    </div>
    
    <MudGrid Spacing="0">
        <MudItem xs="14" md="4" Class="pa-4 border-right">
            <MudStack Spacing="3">
                <MudStack Spacing="2">
                    <MudText Style="font-weight:bold">Username</MudText>
                    <MudText>@appState.AuthenticationDetails?.Username</MudText>
                </MudStack>
                
                <MudStack Spacing="2">
                    <MudText Style="font-weight:bold">First Name</MudText>
                    <MudText>@appState.AuthenticationDetails?.FirstName</MudText>
                </MudStack>
                
                <MudStack Spacing="2">
                    <MudText Style="font-weight:bold">Last Name</MudText>
                    <MudText>@appState.AuthenticationDetails?.LastName</MudText>
                </MudStack>
            
                <MudStack Spacing="2">
                    <MudText Style="font-weight:bold">Role</MudText>
                    <MudText>@appState.AuthenticationDetails?.Role</MudText>
                </MudStack>
                
                <MudStack Spacing="2">
                    <MudText Style="font-weight:bold">Last Logged In</MudText>
                    <MudText>
                        @appState.AuthenticationDetails?.LastLoggedIn?.ToString("ddd dd.MM.yyyy HH:mm:ss", new System.Globalization.CultureInfo("en-GB"))
                    </MudText>
                </MudStack>
            </MudStack>
        </MudItem>
        
        <MudItem xs="12" md="8" Class="pa-4 d-flex flex-column" Style="min-height: 310px">
            <MudStack spacing="4">
                <MudStack Spacing="2">
                    <MudText Style="font-weight:bold">Permissions</MudText>
                    @switch(@appState.AuthenticationDetails?.Role)
                    {
                        case "NoRole":
                            <div class="d-flex align-center">
                                <MudIcon Icon="@Icons.Material.Filled.RadioButtonChecked" Color="Color.Error" Size="Size.Small" Class="mr-2"></MudIcon>
                                <MudText>You do not have any permissions</MudText>
                            </div>
                            break;
                        case "Viewer":
                            <MudText>View robot telemetry</MudText>
                            <div class="d-flex align-center">
                                <MudIcon Icon="@Icons.Material.Filled.RadioButtonChecked" Color="Color.Success" Size="Size.Small" Class="mr-2"></MudIcon>
                                <MudText>View robot telemetry</MudText>
                            </div>
                            break;
                        case "Auditor":
                            <div class="d-flex align-center">
                                <MudIcon Icon="@Icons.Material.Filled.RadioButtonChecked" Color="Color.Success" Size="Size.Small" Class="mr-2"></MudIcon>
                                <MudText>View robot telemetry</MudText>
                            </div>
                            <div class="d-flex align-center">
                                <MudIcon Icon="@Icons.Material.Filled.RadioButtonChecked" Color="Color.Success" Size="Size.Small" Class="mr-2"></MudIcon>
                                <MudText>View audit logs</MudText>
                            </div>
                            <div class="d-flex align-center">
                                <MudIcon Icon="@Icons.Material.Filled.RadioButtonChecked" Color="Color.Success" Size="Size.Small" Class="mr-2"></MudIcon>
                                <MudText>View system status</MudText>
                            </div>
                            break;
                        case "Commander":
                            <div class="d-flex align-center">
                                <MudIcon Icon="@Icons.Material.Filled.RadioButtonChecked" Color="Color.Success" Size="Size.Small" Class="mr-2"></MudIcon>
                                <MudText>View robot telemetry</MudText>
                            </div>
                            <div class="d-flex align-center">
                                <MudIcon Icon="@Icons.Material.Filled.RadioButtonChecked" Color="Color.Success" Size="Size.Small" Class="mr-2"></MudIcon>
                                <MudText>View audit logs</MudText>
                            </div>
                            <div class="d-flex align-center">
                                <MudIcon Icon="@Icons.Material.Filled.RadioButtonChecked" Color="Color.Success" Size="Size.Small" Class="mr-2"></MudIcon>
                                <MudText>Send robot commands</MudText>
                            </div>
                            break;
                        case "Admin":
                            <div class="d-flex align-center">
                                <MudIcon Icon="@Icons.Material.Filled.RadioButtonChecked" Color="Color.Success" Size="Size.Small" Class="mr-2"></MudIcon>
                                <MudText>View robot telemetry</MudText>
                            </div>
                            <div class="d-flex align-center">
                                <MudIcon Icon="@Icons.Material.Filled.RadioButtonChecked" Color="Color.Success" Size="Size.Small" Class="mr-2"></MudIcon>
                                <MudText>View audit logs</MudText>
                            </div>
                            <div class="d-flex align-center">
                                <MudIcon Icon="@Icons.Material.Filled.RadioButtonChecked" Color="Color.Success" Size="Size.Small" Class="mr-2"></MudIcon>
                                <MudText>View system status</MudText>
                            </div>
                            <div class="d-flex align-center">
                                <MudIcon Icon="@Icons.Material.Filled.RadioButtonChecked" Color="Color.Success" Size="Size.Small" Class="mr-2"></MudIcon>
                                <MudText>Send robot commands</MudText>
                            </div>
                            <div class="d-flex align-center">
                                <MudIcon Icon="@Icons.Material.Filled.RadioButtonChecked" Color="Color.Success" Size="Size.Small" Class="mr-2"></MudIcon>
                                <MudText>Delete users</MudText>
                            </div>
                            <div class="d-flex align-center">
                                <MudIcon Icon="@Icons.Material.Filled.RadioButtonChecked" Color="Color.Success" Size="Size.Small" Class="mr-2"></MudIcon>
                                <MudText>Change user roles</MudText>
                            </div>
                            break;
                    }
                    
                </MudStack>
            
                <MudStack Spacing="2">
                    <MudText Style="font-weight:bold">Session Expires At</MudText>
                    <MudText>@TokenExpiryTime.ToString("ddd dd.MM.yyyy HH:mm:ss", new System.Globalization.CultureInfo("en-GB"))</MudText>
                </MudStack>
                
                <MudStack Spacing="2">
                    <MudText Style="font-weight:bold">Session Expires In</MudText>
                    <MudText>@GetTokenExpiryCountdownTime()</MudText>
                </MudStack>
            </MudStack>
        </MudItem>
        
        
    </MudGrid>
</MudPaper>