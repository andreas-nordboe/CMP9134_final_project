@using RobotManagementSystem.Shared.Models.Components
<MudContainer MaxWidth="MaxWidth.Small" Class="d-flex align-center justify-center" Style="height: 100vh">
    <MudPaper Elevation="3">
        <div style="display: grid;
            grid-template-columns: repeat(21, 42px);
            grid-template-rows: repeat(21, 42px);
            gap: 2px;
            width: fit-content;
            padding: 5px;">
            @foreach (var tile in Tiles)
            {
                <MudPaper @onclick="() => OnTileClicked(tile)" 
                          Style="@($"width: 42px; height: 42px; display: flex; align-items: center; justify-content: center; border: 1px solid #ccc; " + 
                                 (tile.ContentType == GridTileType.Obstacle ? "background-color: #424242; color: white;" : "background-color: --mud-palette-primary-lighten; color: black;"))" 
                          Elevation="1" 
                          Square="true">
                    @if (!string.IsNullOrWhiteSpace(tile.ImageUrl))
                    { 
                        <img src="@tile.ImageUrl" style="width: 36px; height: 36px; object-fit: contain;"/>
                    }
                    @*<div class="tile-text">
                        <MudText>@tile.VectorPosition.X,@tile.VectorPosition.Y</MudText>
                    </div>*@
                </MudPaper>
            }
        </div>
    </MudPaper>
</MudContainer>

