@using RobotManagementSystem.Shared.Models.Components

<div class="@MapShellClass">

    <div class="robot-map-panel">

        <div class="robot-map-toolbar">
            <MudText Typo="Typo.caption" Class="map-toolbar-title">
                Robot Map
            </MudText>

            <MudSwitch T="bool"
                       Value="@ShowCoordinates"
                       ValueChanged="OnShowCoordinatesChanged"
                       Color="Color.Primary"
                       Label="Coordinates"
                       Size="Size.Small" />
        </div>

        <div class="robot-grid"
             style="grid-template-columns: repeat(@GridWidth, minmax(0, 1fr)); grid-template-rows: repeat(@GridHeight, minmax(0, 1fr));">

            @foreach (var tile in Tiles)
            {
                <div @onclick="() => OnTileClicked(tile)"
                     class="@GetTileClass(tile)">

                    @if (!string.IsNullOrWhiteSpace(tile.ImageUrl))
                    {
                        <img src="@tile.ImageUrl"
                             class="tile-image"
                             alt="Robot" />
                    }
                    
                    @if (tile.ContentType == GridTileType.ChargingStation ||
                         tile.OriginalContentType == GridTileType.ChargingStation)
                    {
                        <MudIcon Icon="@Icons.Material.Filled.BatteryChargingFull"
                                 Class="charging-station-icon" />
                    }

                    @if (ShowCoordinates)
                    {
                        <span class="tile-coordinates">
                            @tile.VectorPosition.X,@tile.VectorPosition.Y
                        </span>
                    }

                </div>
            }

        </div>

    </div>

</div>