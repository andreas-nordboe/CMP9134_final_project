<MudContainer MaxWidth="MaxWidth.Small" Class="d-flex align-center justify-center" Style="height: 100vh">
    <MudPaper Elevation="3">
        <div style="display: grid;
            grid-template-columns: repeat(21, 42px);
            grid-template-rows: repeat(21, 42px);
            gap: 2px;
            width: fit-content;
            padding: 5px;">
            @foreach (var tile in Tiles)
            {
                <MudPaper Style="width: 42px;
                height: 42px;
                border: 1px solid #ccc;
                background: white;
                display: flex;
                align-items: center;
                justify-content: center;
                overflow: hidden;
                user-select: none;
                cursor: pointer;
                font-size: 10px;
                text-align: center;" Class="@($"robot-tile {GetTileCssClass(tile)}")"
                          Elevation="1" Square="true" @onclick="() => OnTileClicked(tile)">
                    @if (!string.IsNullOrWhiteSpace(tile.ImageUrl))
                    {
                        <img src="@tile.ImageUrl" class="tile-image"/>
                    }
                    @*<div class="tile-text">
                        <MudText>@tile.VectorPosition.X,@tile.VectorPosition.Y</MudText>
                    </div>*@
                </MudPaper>
            }
        </div>
    </MudPaper>
</MudContainer>

