<MudStack>
    <MudPaper Class="d-flex flex-column align-center justify-center mud-width-full py-8"
              Style="min-height: 50px">
        <MudText Align="Align.Center">Robot Telemetry: @ConnectionStatus</MudText>
    </MudPaper>
    @if (LatestTelemetry == null)
    {
        <MudText Align="Align.Center">Waiting for telemetry from robot connection...</MudText>
    }
    else
    {
        <MudGrid>
            <MudItem xs="6">
                <MudPaper Class="d-flex flex-column align-center justify-center mud-width-full py-8"
                          Style="min-width: 150px; min-height: 200px">
                    <MudText>Position</MudText>
                    <MudText>(@LatestTelemetry.Position?.X, @LatestTelemetry.Position?.Y)</MudText>
                </MudPaper>
            </MudItem>
            <MudItem xs="6">
                <MudPaper Class="d-flex flex-column align-center justify-center mud-width-full py-8"
                          Style="min-width: 150px; min-height: 200px">
                    <MudText>Status</MudText>
                    <MudText>@LatestTelemetry.Status</MudText>
                </MudPaper>
            </MudItem>
            <MudItem xs="6">
                <MudPaper Class="d-flex flex-column align-center justify-center mud-width-full py-8"
                          Style="min-width: 150px; min-height: 200px">
                    <MudText>Battery Level</MudText>
                    <MudText>@LatestTelemetry.Battery%</MudText>
                </MudPaper>
            </MudItem>
            <MudItem xs="6">
                <MudPaper Class="d-flex flex-column align-center justify-center mud-width-full py-8"
                          Style="min-width: 150px; min-height: 200px">
                    <MudText>Lidar</MudText>
                    <MudText>13.04.2026</MudText>
                    <MudText>23:18:00</MudText>
                
                </MudPaper>
            </MudItem>
        </MudGrid>
    }
    
</MudStack>
